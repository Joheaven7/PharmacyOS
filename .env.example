# PharmacyOS Environment Variables Template

# Node Environment
NODE_ENV=development
PORT=5000

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacyos?schema=public"

# Auth / Session Configuration
SESSION_SECRET="super-secret-key-change-this-in-production-min-32-chars"
COOKIE_DOMAIN="localhost"

# Frontend Configuration
NEXT_PUBLIC_API_URL="http://localhost:5000"
